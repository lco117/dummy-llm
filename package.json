{
  "name": "dummy-llm",
  "version": "0.4.0",
  "description": "An LLM that says whatever you said - after a hardcoded thinking step. Speaks OpenAI, Anthropic, Gemini and Ollama with byte-exact streaming.",
  "keywords": [
    "reasoning",
    "llm",
    "mock",
    "fake",
    "stub",
    "openai",
    "anthropic",
    "gemini",
    "ollama",
    "sse",
    "streaming",
    "testing",
    "cloudflare-workers",
    "dummy"
  ],
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lco117/dummy-llm.git"
  },
  "homepage": "https://github.com/lco117/dummy-llm#readme",
  "bugs": {
    "url": "https://github.com/lco117/dummy-llm/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dummy-llm": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./worker": "./src/adapters/worker.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "wrangler.jsonc"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node src/adapters/node.ts",
    "start": "node dist/cli.js",
    "test": "node --test test/golden.test.ts test/unit.test.ts test/admin.test.ts",
    "golden": "node scripts/golden.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist-worker",
    "set-repo": "node scripts/set-repo.mjs",
    "prepublishOnly": "npm run build",
    "preversion": "npm run typecheck && npm test",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "release": "npm version patch && git push --follow-tags"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
