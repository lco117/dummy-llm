{
  "name": "parrot-llm",
  "version": "0.1.0",
  "description": "A fake LLM that always says the same thing - and speaks fluent OpenAI, Anthropic, Gemini and Ollama, with byte-exact streaming.",
  "keywords": [
    "llm",
    "mock",
    "fake",
    "stub",
    "openai",
    "anthropic",
    "gemini",
    "ollama",
    "sse",
    "streaming",
    "testing",
    "cloudflare-workers",
    "parrot"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "parrot-llm": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./worker": "./src/adapters/worker.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "wrangler.jsonc"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node src/adapters/node.ts",
    "start": "node dist/cli.js",
    "test": "node --test test/golden.test.ts test/unit.test.ts",
    "golden": "node scripts/golden.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist-worker"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
