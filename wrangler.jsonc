{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dummy-llm",
  "main": "src/adapters/worker.ts",
  "compatibility_date": "2025-09-01",
  // No *.workers.dev route and no preview URLs: bind your own domain instead
  // (Cloudflare dashboard -> the Worker -> Settings -> Domains & Routes).
  // Flip either to true (or delete the line) to get the free workers.dev URL back.
  "workers_dev": false,
  "preview_urls": false,
  // The hostname this Worker answers on. Declaring it here keeps the binding across
  // deploys instead of resetting the Worker to "no routes".
  "routes": [{ "pattern": "dummy.example.com", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  // The admin page is off until an operator turns it on, and its key is a SECRET, not a var:
  //   npx wrangler secret put DUMMY_ADMIN_KEY
  // See docs/admin.md. To let the page save changes, create the namespace and uncomment this:
  //   npx wrangler kv namespace create ADMIN_KV
  // "kv_namespaces": [{ "binding": "ADMIN_KV", "id": "<printed id>" }],
  // (Omitting the id works with the Deploy to Cloudflare button, which provisions the namespace.)
  // Then set "DUMMY_STORE": "kv" in the vars block below.

  // Non-secret defaults. Everything can be overridden in the Cloudflare dashboard.
  "vars": {
    "DUMMY_REPLY": "{input}",
    // DUMMY_CHUNK is left unset on purpose: the code default is 4 code points
    // (~one token), which is what makes DUMMY_TPS mean tokens per second.
    "DUMMY_TPS": "100",
    // One JSON line per request, visible in Workers Logs / `npx wrangler tail dummy-llm`.
    // Set to "off" (or "full" to include whole request bodies).
    "DUMMY_LOG": "summary",
    // Lets the landing page offer a shareable ?t=<template> link (nothing is stored).
    "DUMMY_PLAYGROUND": "1"
  }
}
