{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "npc-llm",
  "main": "src/adapters/worker.ts",
  "compatibility_date": "2025-09-01",
  // No *.workers.dev route and no preview URLs: bind your own domain instead
  // (Cloudflare dashboard -> the Worker -> Settings -> Domains & Routes).
  // Flip either to true (or delete the line) to get the free workers.dev URL back.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // Non-secret defaults. Everything can be overridden in the Cloudflare dashboard.
  "vars": {
    "NPC_TEXT": "6",
    "NPC_MODE": "echo",
    // NPC_CHUNK is left unset on purpose: the code default is 4 code points
    // (~one token), which is what makes NPC_TPS mean tokens per second.
    "NPC_TPS": "100",
    // One JSON line per request, visible in Workers Logs / `npx wrangler tail npc-llm`.
    // Set to "off" (or "full" to include whole request bodies).
    "NPC_LOG": "summary"
  }
}
